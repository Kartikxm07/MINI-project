# Copy this file to `.env` and paste your key after the = (no quotes).
# The code loads `.env` automatically (see src/news/providers.py:load_env_file).
# Real shell environment variables take precedence over this file.

# Finnhub (https://finnhub.io) -- historical company news, free tier ~1 year:
FINNHUB_API_KEY=

# Alpha Vantage (https://www.alphavantage.co) -- NEWS_SENTIMENT, free tier is rate limited:
ALPHAVANTAGE_API_KEY=
